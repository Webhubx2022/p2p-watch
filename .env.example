# انسخ الملف باسم .env واملأ القيم

# توكن البوت من @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# معرف القناة: @channel_username أو الرقم مثل -1001234567890
TELEGRAM_CHAT_ID=@my_channel

FIAT=SDG
ASSET=USDT

# كل كم ثانية يفحص السوق
POLL_SECONDS=60
# نسبة التغير التي يرسل عندها التنبيه (%)
THRESHOLD_PERCENT=1.0
# السعر = وسيط أفضل TOP_N إعلان
TOP_N=5
# تجاهل المعلنين الذين طلباتهم الشهرية أقل من هذا
MIN_ORDERS=10
# طرق الدفع (اختياري، مفصولة بفاصلة). اتركه فارغ لكل الطرق
PAY_TYPES=
